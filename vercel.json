{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{templates/**,static/**,model/*.onnx*,*.py}",
      "excludeFiles": "model/*.pth"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.py" }]
}
